<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PortProxyManager.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 资源图标：Wails 项目静态 ICO 的本地副本 -->
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- 单文件发布要求此项为 true（生成嵌入式 resources.pri）；
         WindowsPackageType=None 之下不影响未打包运行形态 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!-- 未打包 + 自包含 Windows App SDK 运行时：绿色便携，与旧版一致。
         不走 MSIX identity——本应用要写 HKLM 并调用 netsh，打包运行的注册表虚拟化会导致行为失真。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- 手写 Main：CLI 分发、UAC 自提权、单实例都要在 XAML 应用启动之前完成 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>local</Company>
    <Product>PortProxy 管理器 (WinUI)</Product>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 静态图标（从 Wails 项目复制到本项目 Assets，构建不依赖 Wails 目录）：
         exe/窗口图标用 ICO（复制到输出目录供 AppWindow.SetIcon 读取），
         托盘图标用 64×64 PNG（嵌入程序集，与 Wails 的 go:embed 一致）。 -->
    <Content Include="Assets\AppIcon.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\TrayIcon.png"
                      LogicalName="PortProxyManager.WinUI.Assets.TrayIcon.png" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- 业务逻辑层只读链接自根目录：单一来源、零复制，根目录修复自动同步。
       这些文件零 WinForms 依赖；SelfTest.cs 调用的 Cli.EnsureConsole/SafeWrite
       由本项目的 Cli\Cli.cs 提供（同名同名空间）。 -->
  <ItemGroup>
    <Compile Include="..\..\Models\**\*.cs" Link="Core\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\Services\**\*.cs" Link="Core\Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\CliOptions.cs" Link="Core\CliOptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.8.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Publish Properties：ReadyToRun 提升启动速度；裁剪必须关闭——
       业务层的 System.Text.Json 反射序列化（AppSettings/meta）会被裁掉。 -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
