<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PortProxyManager.WinUI.Views.EntryEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PortProxyManager.WinUI.ViewModels"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    mc:Ignorable="d">

    <Grid x:Name="Root" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="16,12,16,4">
            <StackPanel Spacing="10">

                <!-- 类型 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="类型" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.FamilyOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedFamily, Mode=TwoWay}" />
                </Grid>

                <!-- 监听地址 / 端口 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="监听地址" />
                    <TextBox
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.ListenAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox
                        Grid.Column="2"
                        Header="端口"
                        LargeChange="100"
                        Maximum="65535"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.ListenPort, Mode=TwoWay}" />
                </Grid>

                <!-- 目标地址 / 端口（可编辑下拉：手输或选自动探测候选） -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="目标地址" />
                    <ComboBox
                        x:Name="ConnectBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        IsEditable="True"
                        IsEnabled="{x:Bind ViewModel.ConnectEnabled, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.AddressOptions, Mode=OneWay}"
                        PlaceholderText="IP 或选择自动探测的虚拟机、局域网设备"
                        SelectionChanged="OnConnectSelectionChanged"
                        TextSubmitted="OnConnectTextSubmitted"
                        Text="{x:Bind ViewModel.ConnectAddress, Mode=OneWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AddressOptionRow">
                                <TextBlock Text="{x:Bind Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <NumberBox
                        Grid.Column="2"
                        Header="端口"
                        LargeChange="100"
                        Maximum="65535"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.ConnectPort, Mode=TwoWay}" />
                </Grid>

                <!-- 目标跟随（WSL / 虚拟机 IP 变化时自动更新目标地址） -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="目标跟随" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.FollowOptions, Mode=OneWay}"
                        PlaceholderText="跟随 WSL / 虚拟机地址"
                        SelectedItem="{x:Bind ViewModel.SelectedFollow, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FollowChoiceRow">
                                <TextBlock Text="{x:Bind Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Grid.Column="2"
                        Command="{x:Bind ViewModel.RefreshFollowCommand}"
                        Content="刷新"
                        ToolTipService.ToolTip="立即重新探测 WSL / 虚拟机地址" />
                </Grid>

                <!-- 连通性测试 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.TestConnectCommand}"
                        Content="测试目标连通性" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.TestResultText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- 名称 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="名称" />
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 分组 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="分组" />
                    <TextBox
                        Grid.Column="1"
                        PlaceholderText="例如：内网服务"
                        Text="{x:Bind ViewModel.Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 备注 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Text="备注" />
                    <TextBox
                        Grid.Column="1"
                        AcceptsReturn="True"
                        Height="60"
                        Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- 防火墙 -->
                <CheckBox Content="同时创建入站放行规则（TCP）" IsChecked="{x:Bind ViewModel.CreateFirewallRule, Mode=TwoWay}" />

                <!-- 等价命令预览 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Text="等价命令" />
                    <TextBox
                        Grid.Column="1"
                        AcceptsReturn="True"
                        Height="60"
                        IsReadOnly="True"
                        IsTextPredictionEnabled="False"
                        FontFamily="Consolas"
                        Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- 错误提示 -->
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="netsh portproxy 只支持 TCP；监听地址填 0.0.0.0 或 * 表示所有网卡。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Grid
            Grid.Row="1"
            Padding="16,10,16,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="取消"
                MinWidth="88">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.ConfirmCommand}"
                Content="{x:Bind ViewModel.ConfirmText, Mode=OneWay}"
                MinWidth="88"
                Style="{StaticResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Window>
