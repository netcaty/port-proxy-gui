<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PortProxyManager.WinUI.Views.ImportPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PortProxyManager.WinUI.ViewModels"
    Title="导入预览"
    mc:Ignorable="d">

    <Grid x:Name="Root" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 汇总 + 全选 -->
        <Grid Grid.Row="0" Margin="16,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <CheckBox
                Grid.Column="1"
                Content="全选"
                IsChecked="{x:Bind ViewModel.SelectAll, Mode=TwoWay}" />
        </Grid>

        <!-- diff 列表 -->
        <ScrollViewer Grid.Row="1" Margin="16,8,16,8">
            <ListView
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiffItemRow">
                        <StackPanel Margin="0,6" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <TextBlock
                                    Foreground="{x:Bind Brush}"
                                    MinWidth="56"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind KindLabel}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ListenText}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="→" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ConnectText}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Name}" />
                            </StackPanel>
                            <TextBlock
                                Margin="34,0,0,0"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind CurrentText}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind CurrentVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- 删除警告 + 底部按钮 -->
        <StackPanel Grid.Row="2" Margin="16,0,16,0">
            <TextBlock
                Foreground="{x:Bind ViewModel.DeleteBrush, Mode=OneWay}"
                Text="警告：所选条目中有删除操作，对应映射将从系统中移除。"
                Visibility="{x:Bind ViewModel.DeleteWarningVisibility, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
        <Grid
            Grid.Row="2"
            VerticalAlignment="Bottom"
            Padding="16,10,16,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="取消"
                MinWidth="88" />
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.ConfirmCommand}"
                Content="{x:Bind ViewModel.ConfirmText, Mode=OneWay}"
                MinWidth="96"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
