<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PortProxyManager.WinUI.Views.EntryEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PortProxyManager.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="Root" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头：返回列表（与取消等价），标题随新增/编辑变化 -->
        <Grid
            Grid.Row="0"
            Padding="12,8,16,4"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Command="{x:Bind ViewModel.CancelCommand}"
                ToolTipService.ToolTip="返回列表 (Esc)">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="16,6,16,4"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel Spacing="10">

                <!-- 类型 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="类型" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.FamilyOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedFamily, Mode=TwoWay}" />
                </Grid>

                <!-- 监听地址 / 端口 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="监听地址" />
                    <TextBox
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.ListenAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox
                        Grid.Column="2"
                        Header="端口"
                        LargeChange="100"
                        Maximum="65535"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.ListenPort, Mode=TwoWay}" />
                </Grid>

                <!-- 目标候选：单一输入框，手输 IP 或选择探测到的地址/设备 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="目标候选" />
                    <ComboBox
                        x:Name="ConnectBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        IsEditable="True"
                        ItemsSource="{x:Bind ViewModel.CandidateOptions, Mode=OneWay}"
                        PlaceholderText="手输 IP，或选择网关 / 局域网设备 / WSL / 虚拟机 / 沙盒"
                        SelectionChanged="OnConnectSelectionChanged"
                        TextSubmitted="OnConnectTextSubmitted"
                        LostFocus="OnConnectLostFocus">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CandidateRow">
                                <TextBlock Text="{x:Bind Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <NumberBox
                        Grid.Column="2"
                        Header="端口"
                        LargeChange="100"
                        Maximum="65535"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.ConnectPort, Mode=TwoWay}" />
                </Grid>

                <!-- 跟随开关 + 连通性测试并排；悬停给出说明 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <CheckBox
                            Content="跟随"
                            IsChecked="{x:Bind ViewModel.FollowChecked, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.FollowEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="对 WSL / 虚拟机 / Windows 沙盒开启 IP 自动跟随；网关 / 局域网设备不支持。" />
                        <Button
                            Command="{x:Bind ViewModel.TestConnectCommand}"
                            Content="测试目标连通性"
                            ToolTipService.ToolTip="按当前目标地址与端口测试 TCP 连通性。" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.TestResultText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- 名称 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="名称" />
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 分组 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="分组" />
                    <TextBox
                        Grid.Column="1"
                        PlaceholderText="例如：内网服务"
                        Text="{x:Bind ViewModel.Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 备注 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Text="备注" />
                    <TextBox
                        Grid.Column="1"
                        AcceptsReturn="True"
                        Height="60"
                        Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- 防火墙 -->
                <CheckBox Content="同时创建入站放行规则（TCP）" IsChecked="{x:Bind ViewModel.CreateFirewallRule, Mode=TwoWay}" />

                <!-- 等价命令预览 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Text="等价命令" />
                    <TextBox
                        Grid.Column="1"
                        AcceptsReturn="True"
                        Height="60"
                        IsReadOnly="True"
                        IsTextPredictionEnabled="False"
                        FontFamily="Consolas"
                        Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- 错误提示 -->
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="netsh portproxy 只支持 TCP；监听地址填 0.0.0.0 或 * 表示所有网卡。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Grid
            Grid.Row="2"
            Padding="16,10,16,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="取消"
                MinWidth="88">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.ConfirmCommand}"
                Content="{x:Bind ViewModel.ConfirmText, Mode=OneWay}"
                MinWidth="88"
                Style="{StaticResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</UserControl>
