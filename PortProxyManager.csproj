<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PortProxyManager</RootNamespace>
    <AssemblyName>PortProxyManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.0</FileVersion>
    <Company>local</Company>
    <Product>PortProxy 管理器</Product>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- winui / wails 是并行工程，各有自己的构建系统；
         SDK 默认通配（**/*.cs）会把它们连同 obj/ 里的生成文件卷进本工程编译 -->
    <Compile Remove="winui\**" />
    <Compile Remove="wails\**" />
    <None Remove="winui\**" />
    <None Remove="wails\**" />
    <EmbeddedResource Remove="winui\**" />
    <EmbeddedResource Remove="wails\**" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
